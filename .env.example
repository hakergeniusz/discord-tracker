# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-token-here

# Optional settings (defaults shown)
COMMAND_PREFIX=!
LOG_LEVEL=INFO
# LOG_FILE=/var/log/discord-tracker/bot.log
# LOG_CHANNEL_ID=123456789012345678
MESSAGE_CACHE_SIZE=1000
MAX_CONTENT_CHARS=1000
# Comma separated snowflakes
IGNORED_CHANNEL_IDS=
IGNORED_USER_IDS=
LOG_BOT_MESSAGES=false
# Requires the Server Members Intent in the Discord developer portal
ENABLE_MEMBER_EVENTS=true
# OWNER_ID=123456789012345678
